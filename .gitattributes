# ==========================================================================
# GOFLASH CORE - GIT ATTRIBUTES
# Normalização de quebras de linha e tratamento de arquivos
# ==========================================================================

# Normalização automática para todos os arquivos de texto
* text=auto eol=lf

# Arquivos de código e estruturação (forçar quebra de linha LF)
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Arquivos binários (sem conversão de quebra de linha)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
